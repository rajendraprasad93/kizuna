# Application Configuration
VITE_APP_NAME="CivicEye — AI-Powered City Problem Intelligence"
VITE_APP_VERSION="1.0.0"

# Supabase Backend Configuration
# Replace these with your Supabase Project URL and Anon API Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Map Tile Configuration (OpenStreetMap default)
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Backend secrets — placeholders only. Never commit real values.
# Copy this file to .env and replace every placeholder.
JWT_SECRET=replace-with-a-long-random-secret
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/civiceye
NODE_ENV=development
